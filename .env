# logger configurations.
log_level=INFO
log_path=./logs/

# report configurations.
report_path=./reports/

# postgresql configurations.
username=simonpoon
password=password
host=localhost
port=5432
db_name=GovNews

# ollama model for extracting information from user query.
ollama_extraction_model=mistral:latest

# ollama model for map summarization
ollama_map_model=llama3:8b

# ollama model for reduce summarization.
ollama_reduce_model=QyrouNnet/summarizer:400m  #llama3.2:3b

# batch size
batch_size=5